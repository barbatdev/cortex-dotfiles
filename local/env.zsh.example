# local/env.zsh — Configuración personal (NO commitear, gitignored)
# Copiá este archivo a local/env.zsh y editalo con tus valores

# Directorio raíz de todos tus proyectos
# export WORKSPACE_DIR="$HOME/dev"

# Proyectos personales
# export PERSONAL_PROJECTS_DIR="$WORKSPACE_DIR/personal"

# Proyectos de empresa/org
# export WORK_PROJECTS_DIR="$WORKSPACE_DIR/work"

# Directorio de screenshots
# export SCREENSHOTS_DIR="$HOME/Screenshots"

# OpenCode
# export OPENCODE_DEFAULT_FLAGS=""

# Navegación rápida para proyectos de una organización/equipo
# export INNIT_DIR="$WORKSPACE_DIR/innit"
# export INNIT_APIS_DIR="$INNIT_DIR/apis"
# export INNIT_MOBILE_DIR="$INNIT_DIR/mobile"
# export INNIT_WEBS_DIR="$INNIT_DIR/webs"
# export INNIT_PCSOFT_DIR="$INNIT_DIR/pcsoft"

# Tokens y API keys para cualquier LLM (nunca en el repo)
# export ANTHROPIC_API_KEY="tu-key-aqui"
# export OPENAI_API_KEY="tu-key-aqui"
# export GEMINI_API_KEY="tu-key-aqui"

# Aliases personales adicionales
# alias my-project="cd $WORK_PROJECTS_DIR/my-project"

# Endpoints de los brains remotos (ollama + postgres).
# El plugin brains_health.sh sourcea este archivo directamente al inicio de cada ejecución,
# resolviendo la ruta real del script para llegar a dotfiles/local/env.zsh sin depender
# del entorno heredado del daemon launchd (que no propaga vars de subshells de usuario).
# Sin estos valores, el plugin muestra "brains off" (comportamiento esperado).
# NUNCA commitear el host/IP real; editá tu local/env.zsh con los valores correctos.
# export CORTEX_BRAINS_OLLAMA_URL="http://<brains-host>:11434"
# export CORTEX_BRAINS_PG_HOST="<brains-host>"
# export CORTEX_BRAINS_PG_PORT="5432"
