#!/bin/bash

# Config sin scripting addition: macOS 27 rompe el SA (asmvik/yabai#2800).
# El binario está parcheado (alias 27->26) para window management; las
# operaciones de spaces vía yabai no existen sin SA: se usan los atajos
# nativos de Mission Control (ctrl+1..9 activables en Ajustes).

# Resincronización tras suspensión: al despertar, los monitores externos
# vuelven a conectarse y yabai queda con ventanas mal ubicadas. La signal
# display_added dispara un script con debounce que reinicia el Dock
# (workaround conocido, ver asmvik/yabai#259, #159, #1237). No se usa
# display_changed porque en macOS 27 también se dispara al minimizar
# ventanas, y el restart del Dock las des-minimiza. El debounce evita
# múltiples restarts.
SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]:-$HOME/.yabairc}")")"
yabai -m signal --add event=display_added action="$SCRIPT_DIR/scripts/wake-resync.sh &"

yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config split_ratio 0.50
yabai -m config auto_balance off

yabai -m config top_padding 0
yabai -m config bottom_padding 0
yabai -m config left_padding 0
yabai -m config right_padding 0
yabai -m config window_gap 0

# Sin padding global: las ventanas usan todo el monitor disponible.

yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

# Apps que suelen funcionar mejor flotantes.
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Activity Monitor$" manage=off
yabai -m rule --add app="^Finder$" title="^(Copy|Move|Info|Preferences)" manage=off

sketchybar --trigger space_change 2>/dev/null || true
