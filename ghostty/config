# Fuente primaria: FiraCode Beard custom. Fallback: Nerd Font oficial para glyphs.
font-family = FiraCode Nerd Font Mono Beard
font-family = FiraCode Nerd Font
font-size = 14

# Theme: RefactorIA dark defaults from the official site tokens.
background = #0B0714
foreground = #FFFFFF
cursor-color = #7127FF
cursor-text = #0B0714
selection-background = #FFFFFF
selection-foreground = #0B0714

# ANSI semantic colors are adapted for contrast; they are not RefactorIA brand tokens.
palette = 0=#0B0714
palette = 1=#FF6B8A
palette = 2=#58E6A8
palette = 3=#FFC857
palette = 4=#8CC8FF
palette = 5=#C7A6FF
palette = 6=#66E6E6
palette = 7=#FFFFFF

# Bright ANSI variants retain the same semantic roles.
palette = 8=#8F839D
palette = 9=#FF9CB0
palette = 10=#8FF0C3
palette = 11=#FFD98A
palette = 12=#B8DDFF
palette = 13=#E1CFFF
palette = 14=#A8F2F2
palette = 15=#FFFFFF

# Transparencia
background-opacity = 0.95
unfocused-split-opacity = 0.85

# Ventana
window-decoration = true
window-padding-balance = true
window-step-resize = false
macos-titlebar-style = tabs
window-padding-x = 4
window-padding-y = 2

# Cursor
cursor-style = block_hollow

# Shaders desactivados en modo trabajo remoto: reducen legibilidad en multiplexers.
# custom-shader = shaders/cursor_smear_soft.glsl

# Integración con shell
shell-integration = zsh

# Option izquierdo como Alt para TUIs; Option derecho conserva tildes/ñ.
macos-option-as-alt = left

# Comportamiento
scrollback-limit = 10000
copy-on-select = clipboard
right-click-action = paste

# Alan-adapted input shortcuts. Outer split bindings below stay available.
keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = cmd+k=clear_screen
keybind = shift+enter=csi:13;2u
keybind = alt+s=write_screen_file:paste
keybind = ctrl+shift+s=write_scrollback_file:paste

# Splits
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+z=toggle_split_zoom
keybind = ctrl+opt+left=resize_split:left,20
keybind = ctrl+opt+right=resize_split:right,20
keybind = ctrl+opt+up=resize_split:up,20
keybind = ctrl+opt+down=resize_split:down,20
keybind = ctrl+opt+equal=equalize_splits
