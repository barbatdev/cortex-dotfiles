# zsh bootstrap: dotfiles first, Cortex integration last.

_cortex_dotfiles_source_optional() {
    local label="$1"
    local path="$2"

    [[ -r "$path" ]] || return 0
    if ! source "$path"; then
        print -u2 -- "zsh: no se pudo cargar $label: $path"
    fi
    return 0
}

_CORTEX_DOTFILES_SHELL_PATH="${CORTEX_DOTFILES_SHELL_ENTRYPOINT:-$HOME/.config/cortex-dotfiles/shell/cortex-dotfiles.zsh}"
_CORTEX_SHELL_PATH="${CORTEX_SHELL_INTEGRATION:-${CORTEX_HOME:-$HOME/.cortex}/shell/cortex.zsh}"

_cortex_dotfiles_source_optional "cortex-dotfiles" "$_CORTEX_DOTFILES_SHELL_PATH"
_cortex_dotfiles_source_optional "Cortex" "$_CORTEX_SHELL_PATH"

unset _CORTEX_DOTFILES_SHELL_PATH _CORTEX_SHELL_PATH
unfunction _cortex_dotfiles_source_optional
