#!/usr/bin/env bash
# gs - gentle-shell launcher plus one disposable worktree per PR for gentle-ai, gentle-shell and engram.
# Never pushes, merges, force-deletes, or edits settings.
set -euo pipefail

CLONES="$HOME/dev/gentle"
TREES="$HOME/dev/worktrees"
REPOS="gentle-ai gentle-shell engram"
# Mac-only app clones (~/dev/gentle): synced by gs sync on non-workshop hosts,
# never touched on workshop machines.
MAC_APP_REPOS="gentle-dot gentle-shell-desktop"

die() { printf 'gs: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
gs - gentle-shell on main, plus one disposable worktree per PR

  gs [pi args...]          Open gentle-shell (--isolated) in the current directory.
                           Consumer: always the main build from gs sync.
                           Workshop: inside a gentle-shell clone or worktree, Pi
                           loads that path (gs run); elsewhere the synced clone.

  gs pr [repo] <n>         One step to review PR <n>: worktree (reused and
                           updated if it exists), then Pi on it for shell PRs
  gs issue [repo] <n>      One step to start issue <n>: race check (stops if the
                           issue is closed, assigned to someone other than you,
                           or referenced by a PR; GS_FORCE=1 skips it),
                           branch <type>/<n>-<slug> from origin/main,
                           then Pi on it for shell issues

  gs new <repo> <name>     New branch <name> from fresh origin/main
  gs review <repo> <pr>    Check out someone else's PR to test or review it
  gs base <repo>           Clean origin/main worktree, to compare failures
  gs run [pi args...]      Run gentle-shell --isolated with this worktree as --package-root
  gs sync                  Bring gentle-shell, gentle-ai and engram to main, run
                           gentle-ai sync for managed configs, and check compatibility
                           (workshop: local clones; elsewhere: GitHub)
                           Workshop: gentle-ai sync --agents claude-code, then
                           gentle-shell --isolated setup (re-provisions the isolated home)
                           GS_SYNC_AGENTS=a,b scopes gentle-ai sync to those runtimes;
                           GS_SKIP_AI_SYNC=1 skips both steps (binaries only)
                           Then pulls the dotfiles clone (clean, on main only); the
                           shell profile reads it in place. GS_SKIP_DOTFILES=1
                           skips this step
  gs ls                    List open worktrees
  gs done                  Remove the current worktree and its merged local branch
                           (drops odd/tasks records; refuses if real work would be lost)
  gs help                  Show this help

  <repo>: ai | shell | engram   (or the full name)
  [repo] is optional inside a clone or worktree of that repo.

Fastest start:
  gs pr shell 1503                 ->  review a PR: Pi opens on it with a review kickoff
  gs issue ai 1234                 ->  take an issue: branch ready, kickoff prompt, nothing claimed
  gs done                          ->  inside the worktree, after the merge
  (claim, comment, label, push and merge stay yours)
  Each session: one worktree, Pi loads the package from it, /reload picks up edits.
  Sessions share the isolated home ~/.gentle-shell/agent (--isolated, never
  --link) and subagents use the main clone. Workshop sync never runs pi update.
  gs sync is separate: run it with no other session open.

gs and gs sync share one source of truth: workshop launches the clone it syncs;
consumer launches the package behind `gentle-shell` on PATH, the one
`gentle-shell upgrade --channel main` replaces. gs sync prints "gs opens: <version>",
compares it with GitHub main, and exits 1 with INCOMPLETE when any step failed
or the launch target is stale.

Machines (gs sync detects the mode):
  agent-gentle  workshop: clean clones in ~/dev/gentle; pr, issue, new, review, run, done
  Mac, agent-dev  consumer: daily innit/barbatdev/refactoria work on gentle main, no clones;
                  only gs sync (then restart Pi) and plain gs in the repo you work on

Daily flow (agent-gentle):
  gs sync                  ->  morning, with no session open
  gs issue shell 1503      ->  one terminal per issue or PR (gs pr shell <n>); Pi opens there
    claim the issue yourself; edit; /reload to see it live in that session only
    fails? gs base shell in another terminal: same on main means not yours
    commit, push, PR: yours
  waiting on CI or review  ->  next gs issue ... in another terminal; gs ls shows them all
  after the merge          ->  gs done inside the worktree
  session closed?          ->  same gs issue/pr again reuses the worktree and reopens Pi
EOF
}

repo_name() {
  case "${1:-}" in
    ai|gentle-ai) echo gentle-ai ;;
    shell|gentle-shell) echo gentle-shell ;;
    engram) echo engram ;;
    dot|gentle-dot) echo gentle-dot ;;
    desktop|gentle-shell-desktop) echo gentle-shell-desktop ;;
    *) die "unknown repo '${1:-}' (use: ai, shell, engram, dot, desktop)" ;;
  esac
}

clone_of() {
  local repo=$1
  [ -d "$CLONES/$repo/.git" ] || die "missing clean clone $CLONES/$repo"
  git -C "$CLONES/$repo" fetch -q --prune origin
  echo "$CLONES/$repo"
}

install_deps() {
  if [ -f "$1/pnpm-lock.yaml" ]; then (cd "$1" && pnpm install --frozen-lockfile); fi
}

finish() {
  printf '\nready: %s\n  cd %s\n' "$1" "$1"
}

# Herdr naming convention: when gs runs inside a Herdr pane (HERDR_ENV=1),
# rename the workspace, tab, and pane to "<repo> - pr/is #<n>" so each worktree
# session is identifiable in the sidebar. Best-effort and silent: gs must never
# fail because Herdr is absent, unreachable, or rejects a label.
herdr_rename() {
  [ "${HERDR_ENV:-}" = 1 ] || return 0
  command -v herdr >/dev/null 2>&1 || return 0
  local label=$1
  herdr workspace rename "${HERDR_WORKSPACE_ID:-}" "$label" >/dev/null 2>&1 || true
  herdr tab rename "${HERDR_TAB_ID:-}" "$label" >/dev/null 2>&1 || true
  herdr pane rename "${HERDR_PANE_ID:-}" "$label" >/dev/null 2>&1 || true
}

# Plain gs (no worktree): label only the tab with the repo name. Same guard,
# same silence; outside a git repo it does nothing.
herdr_tab_repo() {
  [ "${HERDR_ENV:-}" = 1 ] || return 0
  command -v herdr >/dev/null 2>&1 || return 0
  local url name
  url=$(git remote get-url origin 2>/dev/null) || return 0
  name=$(basename "$url"); name=${name%.git}
  herdr tab rename "${HERDR_TAB_ID:-}" "$name" >/dev/null 2>&1 || true
}

cmd_new() {
  [ $# -eq 2 ] || die "usage: gs new <repo> <name>"
  local repo clone path
  repo=$(repo_name "$1"); clone=$(clone_of "$repo"); path="$TREES/$repo-$2"
  [ -e "$path" ] && die "$path already exists"
  git -C "$clone" worktree add -q -b "$2" "$path" origin/main
  herdr_rename "$repo - $2"
  install_deps "$path"; finish "$path"
}

cmd_review() {
  [ $# -eq 2 ] || die "usage: gs review <repo> <pr-number>"
  local repo clone path
  repo=$(repo_name "$1"); clone=$(clone_of "$repo"); path="$TREES/$repo-pr-$2"
  [ -e "$path" ] && die "$path already exists (gs done inside it first)"
  git -C "$clone" worktree add -q --detach "$path" origin/main
  (cd "$path" && gh pr checkout "$2" -R "Gentleman-Programming/$repo" -b "pr-$2")
  herdr_rename "$repo - pr #$2"
  install_deps "$path"; finish "$path"
}

# Repo from the current directory's origin, for the optional [repo] argument.
repo_here() {
  local url; url=$(git remote get-url origin 2>/dev/null) || die "give the repo (ai, shell, engram) or run it inside one"
  case "$url" in
    */gentle-ai|*/gentle-ai.git) echo gentle-ai ;;
    */gentle-shell|*/gentle-shell.git|*/gentle-pi|*/gentle-pi.git) echo gentle-shell ;;
    */engram|*/engram.git) echo engram ;;
    */gentle-dot|*/gentle-dot.git) echo gentle-dot ;;
    */gentle-shell-desktop|*/gentle-shell-desktop.git) echo gentle-shell-desktop ;;
    *) die "cannot tell the repo from $url; give it: ai, shell, engram, dot, desktop" ;;
  esac
}

# Sets REPO and NUM from "[repo] <n>".
repo_and_number() {
  case $# in
    1) REPO=$(repo_here); NUM=$1 ;;
    2) REPO=$(repo_name "$1"); NUM=$2 ;;
    *) die "usage: gs $CMD [repo] <number>" ;;
  esac
  case "$NUM" in ''|*[!0-9]*) die "'$NUM' is not a number" ;; esac
}

# Opens Pi on a gentle-shell worktree with the kickoff prompt $2; other repos
# only print where to go and the prompt to paste.
open_or_finish() {
  if [ "$REPO" = gentle-shell ]; then cd "$1" && cmd_run "$2"
  else finish "$1"; printf '  kickoff: %s\n' "$2"; fi
}

pr_prompt() {
  # Same cortex-only rule as issue_prompt: the cortex variant is mandatory.
  printf 'Review Gentleman-Programming/%s PR #%s using the cortex-maintainer-delivery skill, loading it first (never the plain maintainer-delivery skill): read the PR, its linked issue, CI status and diff; run its preflight and race check; then report scope, risks, and what to test in Spanish. Do not comment, push, or merge.' "$1" "$2"
}

issue_prompt() {
  # Plan-first: the session presents the kickoff and STOPS. Implementation
  # starts only after the user explicitly approves the plan (agreed workflow;
  # the previous "then work test-first" wording made sessions auto-implement).
  # The CORTEX variant of the skill is mandatory, referenced by name (no legacy
  # ~/.pi/agent path: sessions run on the isolated home):
  # there is also a plain maintainer-delivery skill and the session must not
  # pick that one.
  printf 'Take Gentleman-Programming/%s issue #%s using the cortex-maintainer-delivery skill, loading it first (never the plain maintainer-delivery skill): run its preflight, read the issue and repo conventions, then present a kickoff plan (expected behavior, approach, out of scope, branch %s) in Spanish and STOP. Do not implement, edit files, or commit: implementation starts only after the user explicitly approves the plan. Claiming, commenting, pushing, and opening the PR stay mine.' "$1" "$2" "$3"
}

cmd_pr() {
  CMD="pr"; repo_and_number "$@"
  local path="$TREES/$REPO-pr-$NUM"
  if [ -e "$path" ]; then
    [ -z "$(git -C "$path" status --porcelain)" ] || die "$path has local changes; commit, drop, or gs done first"
    (cd "$path" && gh pr checkout "$NUM" -R "Gentleman-Programming/$REPO" -b "pr-$NUM")
    herdr_rename "$REPO - pr #$NUM"
    install_deps "$path"
  else
    cmd_review "$REPO" "$NUM"
  fi
  open_or_finish "$path" "$(pr_prompt "$REPO" "$NUM")"
}

cmd_issue() {
  CMD="issue"; repo_and_number "$@"
  local gh_repo="Gentleman-Programming/$REPO" info state assignees title labels prs prefix slug branch path
  info=$(gh issue view "$NUM" -R "$gh_repo" --json state,assignees,title,labels \
    --jq '[.state, ([.assignees[].login]|join(",")), .title, ([.labels[].name]|join(","))]|join("\u001f")') \
    || die "cannot read $gh_repo#$NUM"
  # \x1f, not \t: read collapses consecutive IFS *whitespace* tabs, so empty
  # assignees/labels fields shift the title into the assignees check.
  IFS=$'\x1f' read -r state assignees title labels <<<"$info"
  path="$TREES/$REPO-issue-$NUM"
  if [ -e "$path" ]; then
    printf 'gs: reusing %s\n' "$path" >&2
    herdr_rename "$REPO - is #$NUM"
    open_or_finish "$path" "$(issue_prompt "$REPO" "$NUM" "$(git -C "$path" branch --show-current)")"; return
  fi
  if [ "${GS_FORCE:-}" != 1 ]; then
    [ "$state" = OPEN ] || die "$gh_repo#$NUM is $state (GS_FORCE=1 to continue)"
    # Your own assignment is your claim, not a race: only others block.
    local me others=""
    me=$(gh api user --jq .login 2>/dev/null || true)
    others=$(printf '%s' "$assignees" | tr ',' '\n' | grep -vxF -- "${me:-}" | paste -sd, - || true)
    [ -z "$others" ] || die "$gh_repo#$NUM is assigned to $others (GS_FORCE=1 to continue)"
    prs=$(gh pr list -R "$gh_repo" --state all --search "$NUM in:title,body" --json number,state,title \
      --jq '.[] | "  #\(.number) \(.state) \(.title)"')
    [ -z "$prs" ] || die "PRs may already reference #$NUM (GS_FORCE=1 to continue):
$prs"
  fi
  case ",$labels," in
    *,type:feature,*) prefix=feat ;;
    *,type:docs,*) prefix=docs ;;
    *,type:refactor,*) prefix=refactor ;;
    *,type:chore,*) prefix=chore ;;
    *) prefix=fix ;;
  esac
  slug=$(printf '%s' "$title" | sed -E 's/^[A-Za-z]+( [a-z]+)?: *//' | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40 | sed -E 's/-+$//')
  branch="$prefix/$NUM-${slug:-issue}"
  git -C "$CLONES/$REPO" worktree add -q -b "$branch" "$path" origin/main
  herdr_rename "$REPO - is #$NUM"
  install_deps "$path"
  printf 'gs: %s#%s "%s" on branch %s\n' "$gh_repo" "$NUM" "$title" "$branch" >&2
  open_or_finish "$path" "$(issue_prompt "$REPO" "$NUM" "$branch")"
}

cmd_base() {
  [ $# -eq 1 ] || die "usage: gs base <repo>"
  local repo clone path
  repo=$(repo_name "$1"); clone=$(clone_of "$repo"); path="$TREES/$repo-base"
  if [ -e "$path" ]; then
    [ -z "$(git -C "$path" status --porcelain)" ] || die "$path has local changes; base must stay clean"
    git -C "$path" checkout -q --detach origin/main
  else
    git -C "$clone" worktree add -q --detach "$path" origin/main
  fi
  install_deps "$path"; finish "$path"
}

cmd_run() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "run it inside a gentle-shell worktree"
  grep -q '"name": *"gentle-pi"' "$root/package.json" 2>/dev/null || die "$root is not gentle-shell"
  [ -d "$root/node_modules" ] || die "no node_modules in $root (pnpm install --frozen-lockfile)"
  printf 'gs: gentle-shell @ %s (%s); subagents use main\n' "$(git -C "$root" rev-parse --short HEAD)" "$root" >&2
  cd "$root" && exec node "$root/bin/gentle-shell.mjs" --isolated --package-root "$root" "$@"
}

# Workshop (agent-gentle): clean clones in ~/dev/gentle, Pi loads the gentle-shell clone.
# Consumer (Mac, agent-dev): no clones; Pi uses git:gentle-pi@main, binaries built from GitHub main.
is_workshop() {
  git -C "$CLONES/gentle-shell" remote get-url origin 2>/dev/null | grep -q 'Gentleman-Programming/gentle-shell'
}

# resolve_link PATH — physical path of PATH after following every symlink
# (portable: macOS readlink has no -f on older releases).
resolve_link() {
  local p=$1 dir link
  while [ -L "$p" ]; do
    dir=$(cd -P "$(dirname "$p")" && pwd); link=$(readlink "$p")
    case "$link" in /*) p=$link ;; *) p="$dir/$link" ;; esac
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$p")" && pwd)" "$(basename "$p")"
}

# shell_root — the single gentle-shell package that gs launches and gs sync checks.
# Workshop: the clean clone. Consumer: the package behind `gentle-shell` on PATH,
# which is exactly what `gentle-shell upgrade --channel main` replaces. The
# launcher loads its extensions and its bundled Pi from this root, so launching
# any other copy runs stale code even after a successful sync.
shell_root() {
  if is_workshop; then echo "$CLONES/gentle-shell"; return 0; fi
  local bin; bin=$(command -v gentle-shell 2>/dev/null) || return 1
  dirname "$(dirname "$(resolve_link "$bin")")"
}

# Labels of failed sync steps; any entry makes gs sync report INCOMPLETE and exit 1.
SYNC_FAILED=""
sync_failed() { SYNC_FAILED="$SYNC_FAILED $1;"; }

# run_quiet LABEL CMD... — one-line ok/FAILED status; full output only on failure.
run_quiet() {
  local label="$1"; shift
  local out; out=$(mktemp)
  if "$@" >"$out" 2>&1; then
    printf '  %-34s ok\n' "$label"
  else
    printf '  %-34s FAILED\n' "$label"
    sed 's/^/      /' "$out"
    sync_failed "$label"
  fi
  rm -f "$out"
}

# Installed versions, tolerant to missing binaries (used for before/after diffs).
# The `|| true` is load-bearing: with pipefail, a missing binary (127) in the
# pipeline would kill the whole script under set -e before any output (this bit
# nan, where gentle-ai is not installed yet).
shell_version() { gentle-shell --version 2>/dev/null | awk 'NR==1{print $2}' || true; }
ai_version()     { "$HOME/.local/bin/gentle-ai" --version 2>/dev/null | awk '{print $2}' || true; }
engram_version() { "$HOME/.local/bin/engram" version 2>/dev/null | awk '{print $2}' || true; }

# changed_part NAME BEFORE AFTER — "name (old -> new)" when the version moved.
# An if without else always returns 0: under set -e, a plain "changed=$(...)"
# assignment must not inherit a failure when nothing changed.
changed_part() {
  if [ -n "$2" ] && [ -n "$3" ] && [ "$2" != "$3" ]; then printf ' %s (%s -> %s)' "$1" "$2" "$3"; fi
}

# sync_dotfiles — pull the dotfiles clone; ~/.zshrc and the profile link into it,
# so hosts never keep hand-edited copies. Sets dot_change (" dotfiles (a -> b)").
# Never fails the sync: every problem is a status line.
sync_dotfiles() {
  local dir="${CORTEX_DOTFILES_DIR:-$HOME/dev/barbatdev/cortex/cortex-dotfiles}"
  local branch old new out
  if [ "${GS_SKIP_DOTFILES:-}" = 1 ]; then
    printf '  %-34s skipped (GS_SKIP_DOTFILES=1)\n' dotfiles; return 0
  fi
  if [ ! -d "$dir/.git" ]; then
    printf '  %-34s skipped (no clone at %s)\n' dotfiles "$dir"; return 0
  fi
  # Never touch work in progress: only a clean clone on main follows origin.
  if [ -n "$(git -C "$dir" status --porcelain 2>/dev/null)" ]; then
    printf '  %-34s skipped (%s has local changes)\n' dotfiles "$dir"; return 0
  fi
  branch=$(git -C "$dir" branch --show-current 2>/dev/null || true)
  if [ "$branch" != main ]; then
    printf '  %-34s skipped (%s is on %s, not main)\n' dotfiles "$dir" "${branch:-detached HEAD}"; return 0
  fi
  old=$(git -C "$dir" rev-parse --short HEAD)
  if ! out=$(git -C "$dir" pull -q --ff-only origin main 2>&1); then
    printf '  %-34s FAILED\n' dotfiles; printf '%s\n' "$out" | sed 's/^/      /'; sync_failed dotfiles; return 0
  fi
  new=$(git -C "$dir" rev-parse --short HEAD)
  printf '  %-34s ok\n' dotfiles
  [ "$old" != "$new" ] && dot_change=" dotfiles ($old -> $new)"
  return 0
}

cmd_sync() {
  local ai_files="" dot_change="" repo shell bin="$HOME/.local/share/gentle-ai/main" reg="$HOME/.pi/gentle-ai/dev-binary.json" name
  # The dev-binary registration is install-level state: the official launcher
  # reads it from ~/.pi/gentle-ai even in the isolated home (gentle-shell
  # lib/gentle-shell-launcher.ts UNMIGRATED_CONFIG_FILES), so it stays there.
  # Versions before the sync power the closing message: restart only on change.
  local shell_before ai_before engram_before
  shell_before=$(shell_version); ai_before=$(ai_version); engram_before=$(engram_version)
  # Stale GOROOT/GOBIN from a removed version manager breaks every go build.
  if [ -n "${GOROOT:-}" ] && [ ! -d "$GOROOT" ]; then unset GOROOT; fi
  if [ -n "${GOBIN:-}" ] && [ ! -d "$(dirname "$GOBIN")" ]; then unset GOBIN; fi
  mkdir -p "$bin" "$HOME/.local/bin" "$(dirname "$reg")"
  if is_workshop; then
    # Workshop runs the Pi bundled in the clone (node_modules): no legacy
    # ~/.pi/agent runtime on PATH and no pi update.
    printf 'gs sync — %s — workshop (local clones)\n' "$(date '+%Y-%m-%d %H:%M')"
    for repo in $REPOS; do
      [ -d "$CLONES/$repo/.git" ] || die "missing clean clone $CLONES/$repo"
      # Untracked files (.engram/, odd/ left by sessions run in the clone) survive
      # checkout and pull untouched; only tracked edits would be at risk.
      [ -z "$(git -C "$CLONES/$repo" status --porcelain --untracked-files=no)" ] || die "$CLONES/$repo has local changes; clean clones only"
      git -C "$CLONES/$repo" checkout -q main
      git -C "$CLONES/$repo" fetch -q --tags origin
      git -C "$CLONES/$repo" pull -q --ff-only origin main
      printf '%-13s %s\n' "$repo" "$(git -C "$CLONES/$repo" log -1 --format='%h %cs %s')"
    done
    (cd "$CLONES/gentle-ai" && GOBIN="$bin" go install ./cmd/gentle-ai)
    (cd "$CLONES/engram" && GOBIN="$bin" go install ./cmd/engram)
    (cd "$CLONES/gentle-shell" && pnpm install --frozen-lockfile --silent)
    (cd "$CLONES/engram/plugin/pi" && npm install --no-save --no-audit --no-fund --omit=peer --silent)
    shell="$CLONES/gentle-shell"
  else
    printf 'gs sync — %s — consumer (official update channels)\n' "$(date '+%Y-%m-%d %H:%M')"
    command -v gentle-shell >/dev/null 2>&1 || die "consumer sync needs gentle-shell on PATH; install it first"
    # pi may live in its managed home instead of PATH (managed install schema).
    command -v pi >/dev/null 2>&1 || export PATH="$HOME/.pi/agent/bin:$PATH"
    # pi self-update cannot handle every installation schema (e.g. bun-compiled
    # /opt/pi binaries): a failure there must not abort the sync, the official
    # main channel below is the actual update path for Shell and AI.
    run_quiet 'pi update' pi update
    # Official main channel: builds Shell + AI from the exact main SHAs and
    # records the channel state, so later upgrades are no-ops when current.
    # Only gentle-shell >= 4.1.0 parses --channel; older launches keep their
    # registry maturity policies happy and just skip this step.
    if [ "$(gentle-shell --version 2>/dev/null | awk 'NR==1{print $2}')" = "4.0.0" ]; then
      printf '  %-34s skipped (4.0.0 cannot follow the main channel yet; needs >= 4.1.0)\n' 'gentle-shell upgrade (main)'
    else
      # Transient failures (GitHub API rate limit, network) must not abort the
      # rest of the sync: extensions, engram and the compat check still run.
      run_quiet 'gentle-shell upgrade (main)' gentle-shell upgrade --channel main
    fi
    run_quiet 'pi update --extensions' pi update --extensions
    # Only remaining homemade piece: the engram core binary (no official channel yet).
    run_quiet 'engram (go install @main)' env GOPROXY=direct GOBIN="$bin" go install github.com/Gentleman-Programming/engram/v3/cmd/engram@main
    # Legacy pi-managed checkout from before the main channel: nothing updates it
    # any more and gs no longer launches it. Kept on disk, never deleted here.
    local legacy="$HOME/.pi/agent/git/github.com/Gentleman-Programming/gentle-pi"
    [ -d "$legacy" ] && printf 'WARN: stale legacy checkout %s is unused (gs launches the gentle-shell on PATH); remove it when convenient\n' "$legacy"
  fi
  shell=$(shell_root) || die "gentle-shell not found on PATH after sync"
  # Mac-only app clones: sync when present, never fail if absent.
  local app_synced=""
  for repo in $MAC_APP_REPOS; do
    [ -d "$CLONES/$repo/.git" ] || continue
    [ -z "$(git -C "$CLONES/$repo" status --porcelain)" ] || { printf '  %-34s skipped (%s has local changes)\n' "$repo" "$repo"; continue; }
    git -C "$CLONES/$repo" checkout -q main 2>/dev/null || true
    git -C "$CLONES/$repo" fetch -q --tags origin
    git -C "$CLONES/$repo" pull -q --ff-only origin main
    app_synced="$app_synced $repo@$(git -C "$CLONES/$repo" log -1 --format=%h)"
  done
  for name in gentle-ai engram; do
    if [ -e "$HOME/.local/bin/$name" ] && [ ! -L "$HOME/.local/bin/$name" ]; then
      mv "$HOME/.local/bin/$name" "$HOME/.local/bin/$name.pre-gw"
      printf 'kept old %s as ~/.local/bin/%s.pre-gw\n' "$name" "$name"
    fi
    ln -sfn "$bin/$name" "$HOME/.local/bin/$name"
  done
  local ai_bin
  if is_workshop; then
    local tmp; tmp=$(mktemp "$(dirname "$reg")/.dev-binary.XXXXXX")
    printf '{"schema":"gentle-pi.dev-binary/v1","path":"%s"}\n' "$bin/gentle-ai" > "$tmp"
    chmod 600 "$tmp"; mv -f "$tmp" "$reg"
    ai_bin="$bin/gentle-ai"
  else
    # The official main channel owns the dev-binary registration; reuse its path.
    ai_bin=$(sed -n 's/.*"path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$reg" 2>/dev/null | head -1)
    [ -x "$ai_bin" ] || die "gentle-ai binary not found in $reg; run: gentle-shell upgrade --channel main"
  fi
  ln -sfn "$ai_bin" "$HOME/.local/bin/gentle-ai"
  ln -sfn "$bin/engram" "$HOME/.local/bin/engram"

  # New binaries are not enough: gentle-ai sync materializes the managed configs
  # (agents, skills, plugins, engram instructions) every runtime reads.
  # GS_SYNC_AGENTS scopes runtimes per host (local env). Workshop defaults to
  # claude-code (Shell runs on the isolated home, provisioned below by
  # gentle-shell setup); consumer empty = gentle-ai default.
  local sync_agents="${GS_SYNC_AGENTS:-}"
  is_workshop && sync_agents="${GS_SYNC_AGENTS:-claude-code}"
  if [ "${GS_SKIP_AI_SYNC:-}" = 1 ]; then
    printf '  %-34s skipped (GS_SKIP_AI_SYNC=1)\n' 'gentle-ai sync'
    is_workshop && printf '  %-34s skipped (GS_SKIP_AI_SYNC=1)\n' 'gentle-shell setup (isolated home)'
  else
    local ai_sync=(sync)
    [ -n "$sync_agents" ] && ai_sync+=(--agents "$sync_agents")
    # Like run_quiet, but keeps the output: its file count feeds the restart hint.
    local ai_out; ai_out=$(mktemp)
    if "$ai_bin" "${ai_sync[@]}" >"$ai_out" 2>&1; then
      printf '  %-34s ok\n' 'gentle-ai sync'
    else
      printf '  %-34s FAILED\n' 'gentle-ai sync'
      sed 's/^/      /' "$ai_out"
      sync_failed 'gentle-ai sync'
    fi
    ai_files=$(sed -n 's/^Sync actions executed: \([0-9][0-9]*\) files* changed.*/\1/p' "$ai_out" | head -1)
    rm -f "$ai_out"
    # Official re-provisioning of the isolated home (~/.gentle-shell/agent) from the clone.
    is_workshop && run_quiet 'gentle-shell setup (isolated home)' \
      node "$CLONES/gentle-shell/bin/gentle-shell.mjs" --isolated setup
  fi
  sync_dotfiles
  # gs sync is the only upgrade path; older homemade scripts drift the hosts apart.
  for name in "$HOME/.local/bin/gentle-maintainer-upgrade" "$HOME/.local/bin/gentle-sync.sh" \
    /usr/bin/gentle-sync.sh /usr/local/bin/gentle-upgrade.sh /bin/gentle-upgrade.sh; do
    [ -e "$name" ] && printf 'WARN: legacy upgrade script %s; use gs sync only and remove it\n' "$name"
  done

  # Versions after the sync decide the closing message: restart only on change.
  local shell_after ai_after engram_after changed
  shell_after=$(shell_version); ai_after=$(ai_version); engram_after=$(engram_version)
  changed="$(changed_part shell "$shell_before" "$shell_after")$(changed_part gentle-ai "$ai_before" "$ai_after")$(changed_part engram "$engram_before" "$engram_after")"
  printf '\nversions: shell %s | gentle-ai %s | engram %s\n' "${shell_after:-?}" "${ai_after:-?}" "${engram_after:-?}"
  # The launch target must be the package this sync just updated: ask it directly.
  local launched
  launched=$( (node "$shell/bin/gentle-shell.mjs" --version 2>/dev/null || true) | awk 'NR==1{print $2}')
  printf 'gs opens:  %s (%s)\n' "${launched:-?}" "$shell"
  if [ -z "$launched" ]; then
    sync_failed "gs launch target $shell unreadable"
  elif [ -n "$shell_after" ] && [ "$launched" != "$shell_after" ]; then
    sync_failed "gs launch target is $launched but gentle-shell on PATH is $shell_after"
  fi
  # Consumer builds carry the main SHA (x.y.z-main.<sha12>): compare with GitHub.
  if ! is_workshop; then
    local built remote
    built=$(printf '%s' "$launched" | sed -n 's/.*-main\.\([0-9a-f]\{7,\}\)$/\1/p')
    remote=$(git ls-remote "${GS_SHELL_REMOTE:-https://github.com/Gentleman-Programming/gentle-pi}" refs/heads/main 2>/dev/null | awk '{print $1}' || true)
    if [ -z "$built" ]; then
      sync_failed "gentle-shell $launched is not a main-channel build"
    elif [ -z "$remote" ]; then
      printf 'WARN: could not read gentle-pi main from GitHub; freshness unverified\n'
    elif [ "${remote#"$built"}" = "$remote" ]; then
      sync_failed "gentle-shell behind main (built ${built}, main ${remote:0:12})"
    fi
  fi
  [ -n "$app_synced" ] && printf 'app repos:%s\n' "$app_synced"
  for name in gentle-ai engram; do
    [ "$(command -v "$name")" = "$HOME/.local/bin/$name" ] || printf 'WARN: %s on PATH is %s, not our build\n' "$name" "$(command -v "$name")"
  done
  local emits reads
  emits=$( ("$ai_bin" review status --cwd "$shell" --contract gentle-ai.review-integration/v2 \
    --agent claude-code --next-transition 2>/dev/null || true) | grep -o 'review-integration\.status/v[0-9]*' | head -1 | sed 's#.*/##' || true)
  reads=$( (grep -rhoE 'review-integration\.status/v[0-9]+' "$shell/lib" "$shell/extensions" 2>/dev/null || true) \
    | sed 's#.*/##' | sort -uV | tr '\n' ' ' || true)
  if [ -z "$emits" ] || [ -z "$reads" ]; then
    printf 'compat:     UNVERIFIED (emits=%s reads=%s)\n' "${emits:-?}" "${reads:-?}"
  elif printf '%s' "$reads" | tr ' ' '\n' | grep -qx "$emits"; then
    printf 'compat:     OK (gentle-ai emits %s, gentle-shell reads %s)\n' "$emits" "$reads"
  else
    printf 'compat:     INCOMPATIBLE (gentle-ai emits %s, gentle-shell reads %s)\n' "$emits" "$reads"
  fi
  if [ -n "$ai_files" ] && [ "$ai_files" -gt 0 ]; then
    changed="$changed managed configs ($ai_files files)"
  fi
  changed="$changed$dot_change"
  if [ -n "$SYNC_FAILED" ]; then
    printf 'INCOMPLETE — failed:%s\n  Some components may be stale; fix the above and run gs sync again.\n' "$SYNC_FAILED"
    [ -n "$changed" ] && printf 'changed anyway:%s\n  Restart Pi to pick them up.\n' "$changed"
    return 1
  elif [ -n "$changed" ]; then
    printf 'changed:%s\n  Restart Pi to pick them up.\n' "$changed"
  else
    printf 'nothing changed — no Pi restart needed.\n'
  fi
}

cmd_ls() {
  local repo
  for repo in $REPOS $MAC_APP_REPOS; do
    [ -d "$CLONES/$repo/.git" ] && git -C "$CLONES/$repo" worktree list | grep -v "^$CLONES/$repo " || true
  done
}

cmd_done() {
  local root; root=$(git rev-parse --show-toplevel 2>/dev/null) || die "run it inside a worktree"
  case "$root" in "$TREES"/*) ;; *) die "$root is not a gs worktree" ;; esac
  # Harness task records (odd/tasks/*) never ship; drop them if they are the only leftovers.
  local other; other=$(git -C "$root" status --porcelain | grep -v '^?? odd/tasks/' || true)
  [ -z "$other" ] || die "uncommitted changes in $root:
$other"
  git -C "$root" status --porcelain | sed -n 's/^?? //p' | while read -r f; do rm -rf "${root:?}/$f"; done
  git -C "$root" fetch -q --prune origin
  if [ -n "$(git -C "$root" log --oneline HEAD --not --remotes)" ] &&
    ! git -C "$root" ls-remote origin 'refs/pull/*/head' | grep -q "^$(git -C "$root" rev-parse HEAD)"; then
    die "commits not on any remote in $root; push or drop them yourself first"
  fi
  local main branch; main=$(git -C "$root" worktree list --porcelain | sed -n '1s/^worktree //p')
  branch=$(git -C "$root" branch --show-current)
  git -C "$main" worktree remove "$root"
  printf 'removed %s\n' "$root"
  if [ -n "$branch" ]; then
    if git -C "$main" merge-base --is-ancestor "$branch" origin/main 2>/dev/null && git -C "$main" branch -D "$branch" >/dev/null 2>&1; then
      printf 'deleted local branch %s (already in origin/main)\n' "$branch"
    else printf 'kept local branch %s (not fully in main; delete it yourself if the PR was squash-merged)\n' "$branch"; fi
  fi
  printf 'now run: cd %s\n' "$main"
}

cmd_launch() {
  local root here
  # Workshop dogfooding: inside any gentle-shell checkout (clone or worktree),
  # Pi loads the package from that path, exactly like gs run.
  if is_workshop && here=$(git rev-parse --show-toplevel 2>/dev/null) &&
    grep -q '"name": *"gentle-pi"' "$here/package.json" 2>/dev/null; then
    herdr_tab_repo
    cmd_run "$@"
  fi
  root=$(shell_root) || die "gentle-shell not on PATH (install it, then run: gs sync)"
  [ -f "$root/bin/gentle-shell.mjs" ] || die "gentle-shell not found at $root (run: gs sync)"
  herdr_tab_repo
  exec node "$root/bin/gentle-shell.mjs" --isolated "$@"
}

case "${1:-}" in
  pr) shift; cmd_pr "$@" ;;
  issue) shift; cmd_issue "$@" ;;
  new) shift; cmd_new "$@" ;;
  review) shift; cmd_review "$@" ;;
  base) shift; cmd_base "$@" ;;
  run) shift; cmd_run "$@" ;;
  sync) cmd_sync ;;
  ls) cmd_ls ;;
  done) cmd_done ;;
  help|-h|--help) usage ;;
  *) cmd_launch "$@" ;;
esac
