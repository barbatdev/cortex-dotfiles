#!/usr/bin/env bash
# gs-official — minimal launcher for the official Gentle Shell (agent-dev only).
#
# Usage:
#   gs [args...]   Run `gentle-shell` with the arguments forwarded unchanged.
#   gs sync        Update Gentle Shell, external Gentle AI and Engram from main,
#                  then sync Gentle AI assets for Claude Code only.
#   gs help        Show this help (`gs --help` and `gs -h` also work).
#
# The legacy bin/gs (Mac/workshop) is a separate script and is not affected.

set -uo pipefail

AI_MODULE="github.com/gentleman-programming/gentle-ai/v4/cmd/gentle-ai@main"
ENGRAM_MODULE="github.com/Gentleman-Programming/engram/v3/cmd/engram@main"
# Only gentle-ai and engram binaries inside this directory may be replaced.
EXPECTED_AI_BIN="$HOME/.local/bin"

usage() {
  sed -n '2,10s/^# \{0,1\}//p' "$0"
}

die() {
  echo "gs: $*" >&2
  exit 1
}

# Run one step; on failure report it and exit with the step's status.
step() {
  "$@"
  local status=$?
  if [ "$status" -ne 0 ]; then
    echo "gs: '$*' failed with exit $status (no fallback attempted)" >&2
    exit "$status"
  fi
}

# Resolve a binary that `gs sync` may replace and print its real directory.
# Refuses anything that is not a user-owned regular file in EXPECTED_AI_BIN.
owned_bin_dir() {
  local name="$1" path dir expected_dir
  path="$(command -v "$name")" || die "$name not found in PATH"
  dir="$(cd "$(dirname "$path")" && pwd -P)"
  expected_dir="$(cd "$EXPECTED_AI_BIN" 2>/dev/null && pwd -P)" \
    || die "expected $name directory $EXPECTED_AI_BIN does not exist"

  [ -L "$path" ] && die "$path is a symlink; refusing to replace it"
  [ "$dir" = "$expected_dir" ] \
    || die "$path is not in the expected directory $EXPECTED_AI_BIN; refusing to replace it"
  [ -f "$path" ] && [ -x "$path" ] || die "$path is not an executable file"
  [ -O "$path" ] || die "$path is not owned by the current user"
  [ -w "$dir" ] || die "$dir is not writable"
  echo "$dir"
}

# Verify every tool and every replaced target before changing anything.
preflight() {
  command -v gentle-shell >/dev/null 2>&1 || die "gentle-shell not found in PATH"
  command -v go >/dev/null 2>&1 || die "go not found in PATH"
  AI_DIR="$(owned_bin_dir gentle-ai)" || exit 1
  AI_PATH="$(command -v gentle-ai)"
  ENGRAM_DIR="$(owned_bin_dir engram)" || exit 1
  ENGRAM_PATH="$(command -v engram)"
}

sync_main() {
  preflight
  echo "==> gentle-shell upgrade --channel main"
  step gentle-shell upgrade --channel main
  echo "==> go install $AI_MODULE (GOBIN=$AI_DIR)"
  step env GOBIN="$AI_DIR" go install "$AI_MODULE"
  echo "==> $AI_PATH sync --agents claude-code"
  step "$AI_PATH" sync --agents claude-code
  echo "==> go install $ENGRAM_MODULE (GOBIN=$ENGRAM_DIR)"
  step env GOBIN="$ENGRAM_DIR" go install "$ENGRAM_MODULE"

  # Source builds from main report version "dev"; the build info revision is
  # what identifies the installed main commit.
  echo "==> installed versions"
  step gentle-shell --version
  step "$AI_PATH" version
  step go version -m "$AI_PATH"
  step "$ENGRAM_PATH" version
  step go version -m "$ENGRAM_PATH"

  # The running server keeps the old binary until its service restarts.
  echo "==> Engram binary updated; restart the Engram service to run it"
}

case "${1:-}" in
  sync)
    [ "$#" -eq 1 ] || { echo "gs: sync takes no arguments" >&2; exit 2; }
    sync_main
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    exec gentle-shell "$@"
    ;;
esac
