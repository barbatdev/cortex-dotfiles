# Copy to ~/.config/fish/conf.d/99-local.fish and keep that file untracked.
# This loads after 10-core.fish and is for machine-specific overrides.
# set -gx WORKSPACE_DIR "$HOME/dev"
# set -gx INNIT_APIS_DIR "$HOME/dev/innit/apis"
# set -gx EDITOR nvim
# Private Git identities: both values are required before git-workdev or git-personaldev can change a repository.
# set -gx GIT_WORKDEV_NAME "Your work name"
# set -gx GIT_WORKDEV_EMAIL "you@company.invalid"
# set -gx GIT_PERSONALDEV_NAME "Your personal name"
# set -gx GIT_PERSONALDEV_EMAIL "you@personal.invalid"
# gs sync runs gentle-ai sync after updating binaries. Scope it to this host's runtimes:
# set -gx GS_SYNC_AGENTS claude-code,opencode,pi
# Binaries only, no managed-config sync:
# set -gx GS_SKIP_AI_SYNC 1
# 10-core.fish defaults GENTLE_AI_CHANNEL to beta; override only on a host that must differ:
# set -gx GENTLE_AI_CHANNEL stable
